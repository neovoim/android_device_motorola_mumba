dontaudit hal_audio_default debugfs:dir r_dir_perms;
set_prop(hal_audio_default, vendor_mot_audio_prop)
dontaudit hal_audio_default default_prop:file read;
set_prop(hal_audio_default, vendor_audio_prop)
allow hal_audio_default vendor_sysfs_battery_supply:dir r_dir_perms;
allow hal_audio_default vendor_sysfs_battery_supply:dir search;
allow hal_audio_default vendor_sysfs_battery_supply:file rw_file_perms;
