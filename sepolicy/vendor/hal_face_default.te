allow hal_face_default fwk_camera_service:service_manager find;
allow hal_face_default hal_graphics_mapper_service:service_manager find;
hal_client_domain(hal_face_default, hal_graphics_allocator)
binder_call(hal_face_default, platform_app)

get_prop(hal_face_default, camera_config_prop)
set_prop(hal_face_default, vendor_faceauth_prop)

allow hal_face_default hal_face_data_file:dir create_dir_perms;
allow hal_face_default hal_face_data_file:file create_file_perms;
